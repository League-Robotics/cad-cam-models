(version 1)
(rule "No top copper routing" (constraint disallow track via) (layer "F.Cu"))
(rule "No vias" (constraint disallow via))
(rule "Milling clearance" (constraint clearance (min 0.3mm)))
(rule "Milling track width" (constraint track_width (min 0.35mm)))
(rule "Edge clearance" (constraint edge_clearance (min 0.5mm)))
